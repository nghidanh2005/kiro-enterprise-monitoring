# Per-customer data: account IDs, survey output, baselines, tfvars. Never commit.
# Only the empty template is tracked.
customers/*
!customers/_template/

# Local Kiro / Kiro Crew settings of the machine that edits this repo
.kiro/settings/

# Superseded first draft, kept on the local machine only
PLAN-kiro-monitoring.md

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Python
__pycache__/
*.pyc
.venv/
vendor/**/.venv/

# Build and transfer artifacts
*.zip
dist/
.build/

# Lock files created by an offline `terraform init -plugin-dir` hold local,
# Windows-only hashes and break other platforms. Generate them online instead.
.terraform.lock.hcl

# draw.io temporary backups
.$*.bkp
*.drawio.bkp

# OS files
Thumbs.db
.DS_Store
