<mxCell id="t6" value="Bucket policy của khách cho đúng 2 role này: s3:GetObject trên kiro/*, s3:ListBucket có điều kiện s3:prefix = kiro/*. Không có quyền ghi hay xoá. Bucket policy lưu role theo unique ID: role bị tạo lại thì phải gắn lại policy, nếu không Lambda chép 0 file mà không báo lỗi." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=6;fillColor=#F2F3F3;strokeColor=#879596;fontColor=#232F3E;" vertex="1" parent="g3"><mxGeometry x="330" y="50" width="410" height="170" as="geometry"/></mxCell>
<mxCell id="x7" value="Bên vận hành gọi API, đọc" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#545B64;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="525" y="176" width="150" height="13" as="geometry"/></mxCell>
<mxCell id="n8" value="Role kiro-mon-idc-read&lt;br&gt;ListUsers" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="g2"><mxGeometry x="150" y="330" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="n9" value="Role Lambda identity map&lt;br&gt;(bản sample của khách)" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="g3"><mxGeometry x="150" y="330" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="t10" value="Trust policy của role phía khách: principal là đúng ARN role identity map, điều kiện sts:ExternalId. Lambda gốc của sample không truyền ExternalId, nên cần bản vá P3. Quyền: identitystore:ListUsers trên Identity Store của khách." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=6;fillColor=#FFF4E5;strokeColor=#ED7100;fontColor=#232F3E;" vertex="1" parent="g3"><mxGeometry x="330" y="280" width="410" height="170" as="geometry"/></mxCell>
