<mxCell id="n12" value="Trail kiro-mon-audit&lt;br&gt;cloudtrail.amazonaws.com" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="g2"><mxGeometry x="150" y="560" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="n13" value="S3 CloudTrail khách&lt;br&gt;+ KMS key bên vận hành" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="g3"><mxGeometry x="150" y="560" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="t14" value="Bucket policy phía vận hành: s3:PutObject trên AWSLogs/&amp;lt;account khách&amp;gt;/*, s3:GetBucketAcl, điều kiện aws:SourceArn = ARN của trail. Key policy cho cloudtrail.amazonaws.com mã hoá với cùng điều kiện. Chưa xác minh: OQ-1 (có data event không) và OQ-11 (bucket khác region được không)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=6;fillColor=#FDECEC;strokeColor=#D13212;fontColor=#B0281A;" vertex="1" parent="g3"><mxGeometry x="330" y="510" width="410" height="170" as="geometry"/></mxCell>
<mxCell id="x15" value="dịch vụ AWS ghi sang" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#545B64;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="540" y="636" width="120" height="13" as="geometry"/></mxCell>
<mxCell id="n16" value="Data Exports ở payer&lt;br&gt;bcm-data-exports" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cost_and_usage_report;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="g2"><mxGeometry x="150" y="790" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="n17" value="S3 data-exports&lt;br&gt;(stack CID Destination)" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="g3"><mxGeometry x="150" y="790" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="t18" value="Stack CID-DataExports-Destination tạo bucket policy cho phép account payer của khách giao export. Export ghi vào &amp;lt;export-name&amp;gt;/&amp;lt;account payer&amp;gt;/. Phía khách chạy stack CID-DataExports-Source, hoặc tạo export lọc chỉ Kiro bằng tay nếu chốt D2." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=6;fillColor=#F2F3F3;strokeColor=#879596;fontColor=#232F3E;" vertex="1" parent="g3"><mxGeometry x="330" y="740" width="410" height="170" as="geometry"/></mxCell>
<mxCell id="x19" value="dịch vụ AWS ghi sang" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#545B64;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="540" y="866" width="120" height="13" as="geometry"/></mxCell>
<mxCell id="n20" value="S3 bucket prompt log&lt;br&gt;SSE-KMS key khách" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="g2"><mxGeometry x="150" y="1020" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="n21" value="Không có principal&lt;br&gt;nào của bên vận hành" style="points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;opacity=40;textOpacity=60;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="g3"><mxGeometry x="150" y="1020" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="t22" value="Chỉ q.amazonaws.com được ghi (điều kiện aws:SourceAccount và aws:SourceArn arn:aws:codewhisperer:...). Chỉ role kiro-prompt-auditor của khách được đọc và giải mã. Task 7.3 chứng minh bằng head-object từ bên vận hành phải ra 403. Metadata chỉ đi qua Lambda của khách khi chốt D4." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=6;fillColor=#F2F3F3;strokeColor=#879596;fontColor=#232F3E;" vertex="1" parent="g3"><mxGeometry x="330" y="970" width="410" height="170" as="geometry"/></mxCell>
<mxCell id="x23" value="không có đường nào" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#545B64;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="546" y="1096" width="108" height="13" as="geometry"/></mxCell>
<mxCell id="t24" value="QuickSight chỉ đọc bucket và Athena trong account trung tâm. Bảng Athena của sample trỏ vào bucket kết quả normalized/, không trỏ vào bucket của khách (đã đo trong build_views.py dòng 93-94). Vì vậy bucket report của khách không cấp quyền cho QuickSight. IP nguồn trong CloudTrail chỉ role audit của bên vận hành query được, không nạp vào SPICE." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=6;fillColor=#F2F3F3;strokeColor=#879596;fontColor=#232F3E;" vertex="1" parent="g3"><mxGeometry x="20" y="1220" width="720" height="160" as="geometry"/></mxCell>
<mxCell id="t25" value="Mọi thay đổi trên account khách là task có đánh dấu XÁC NHẬN trong tasks.md: agent hỏi người vận hành trước từng lần chạy. Bucket policy của bucket report được dựng lại toàn bộ bằng Terraform, giữ nguyên các statement đang có (gồm statement cho q.amazonaws.com ghi report)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=6;fillColor=#F2F3F3;strokeColor=#879596;fontColor=#232F3E;" vertex="1" parent="g2"><mxGeometry x="20" y="1220" width="720" height="160" as="geometry"/></mxCell>
